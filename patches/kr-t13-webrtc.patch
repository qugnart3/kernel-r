@@ -2619,6 +2620,31 @@ void RTCPeerConnection::DidGenerateICECandidate(
   DCHECK(!closed_);
   DCHECK(GetExecutionContext()->IsContextThread());
   DCHECK(platform_candidate);
+
+  auto& fp = blink::kr::FingerprintProfile::Get();
+  if (fp.IsActive() && fp.IsToggleEnabled("webrtc")) {
+    const String& addr = platform_candidate->Address();
+    if (!addr.empty()) {
+      std::string a = addr.Utf8();
+      bool is_private = false;
+      if (a.rfind("10.", 0) == 0 || a.rfind("192.168.", 0) == 0 ||
+          a.rfind("169.254.", 0) == 0 || a.rfind("127.", 0) == 0 ||
+          a.rfind("fc", 0) == 0 || a.rfind("fd", 0) == 0 ||
+          a.rfind("fe80:", 0) == 0 || a == "::1") {
+        is_private = true;
+      } else if (a.rfind("172.", 0) == 0) {
+        size_t dot2 = a.find('.', 4);
+        if (dot2 != std::string::npos) {
+          int octet2 = atoi(a.substr(4, dot2 - 4).c_str());
+          if (octet2 >= 16 && octet2 <= 31)
+            is_private = true;
+        }
+      }
+      if (is_private)
+        return;
+    }
+  }
+
   RTCIceCandidate* ice_candidate = RTCIceCandidate::Create(platform_candidate);
   MaybeDispatchEvent(RTCPeerConnectionIceEvent::Create(ice_candidate));
 }
