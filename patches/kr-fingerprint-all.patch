diff --git a/components/kr_fingerprint/profile_loader.cc b/components/kr_fingerprint/profile_loader.cc
new file mode 100644
index 0000000000..fed970136f
--- /dev/null
+++ b/components/kr_fingerprint/profile_loader.cc
@@ -0,0 +1,242 @@
+#include "components/kr_fingerprint/profile_loader.h"
+
+#include <fstream>
+#include <sstream>
+
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/values.h"
+
+namespace kr {
+
+namespace {
+
+std::string GetString(const base::DictValue& dict, const char* key,
+                      const std::string& fallback = "") {
+  const std::string* v = dict.FindString(key);
+  return v ? *v : fallback;
+}
+
+int GetInt(const base::DictValue& dict, const char* key, int fallback = 0) {
+  return dict.FindInt(key).value_or(fallback);
+}
+
+double GetDouble(const base::DictValue& dict, const char* key,
+                 double fallback = 0.0) {
+  return dict.FindDouble(key).value_or(fallback);
+}
+
+bool GetBool(const base::DictValue& dict, const char* key,
+             bool fallback = false) {
+  return dict.FindBool(key).value_or(fallback);
+}
+
+ScreenData ParseScreen(const base::DictValue& d) {
+  ScreenData s;
+  s.w = GetInt(d, "w", 1920);
+  s.h = GetInt(d, "h", 1080);
+  s.avail_w = GetInt(d, "avail_w", 1920);
+  s.avail_h = GetInt(d, "avail_h", 1040);
+  s.dpr = GetDouble(d, "dpr", 1.0);
+  s.color_depth = GetInt(d, "color_depth", 24);
+  s.inner_w = GetInt(d, "inner_w", 1920);
+  s.inner_h = GetInt(d, "inner_h", 925);
+  s.outer_w = GetInt(d, "outer_w", 1920);
+  s.outer_h = GetInt(d, "outer_h", 1040);
+  return s;
+}
+
+NavigatorData ParseNavigator(const base::DictValue& d) {
+  NavigatorData n;
+  n.cores = GetInt(d, "cores", 8);
+  n.device_memory = GetInt(d, "device_memory", 8);
+  n.platform = GetString(d, "platform", "Win32");
+  n.max_touch_points = GetInt(d, "max_touch_points", 0);
+  n.webdriver = GetBool(d, "webdriver", false);
+  n.cookie_enabled = GetBool(d, "cookie_enabled", true);
+  n.pdf_viewer_enabled = GetBool(d, "pdf_viewer_enabled", true);
+  n.plugins_count = GetInt(d, "plugins_count", 5);
+  n.mime_types_count = GetInt(d, "mime_types_count", 2);
+  return n;
+}
+
+GpuData ParseGpu(const base::DictValue& d) {
+  GpuData g;
+  g.vendor = GetString(d, "vendor");
+  g.renderer = GetString(d, "renderer");
+
+  const base::DictValue* params = d.FindDict("params");
+  if (params) {
+    g.max_texture_size = GetInt(*params, "MAX_TEXTURE_SIZE", 16384);
+    g.max_cube_map_texture_size =
+        GetInt(*params, "MAX_CUBE_MAP_TEXTURE_SIZE", 16384);
+    g.max_texture_image_units =
+        GetInt(*params, "MAX_TEXTURE_IMAGE_UNITS", 16);
+    g.max_vertex_attribs = GetInt(*params, "MAX_VERTEX_ATTRIBS", 16);
+    g.max_vertex_uniform_vectors =
+        GetInt(*params, "MAX_VERTEX_UNIFORM_VECTORS", 4095);
+    g.max_fragment_uniform_vectors =
+        GetInt(*params, "MAX_FRAGMENT_UNIFORM_VECTORS", 1024);
+    g.max_renderbuffer_size = GetInt(*params, "MAX_RENDERBUFFER_SIZE", 16384);
+    g.max_varying_vectors = GetInt(*params, "MAX_VARYING_VECTORS", 30);
+    g.max_vertex_texture_image_units =
+        GetInt(*params, "MAX_VERTEX_TEXTURE_IMAGE_UNITS", 16);
+    g.max_samples = GetInt(*params, "MAX_SAMPLES", 8);
+    g.max_3d_texture_size = GetInt(*params, "MAX_3D_TEXTURE_SIZE", 2048);
+    g.max_array_texture_layers =
+        GetInt(*params, "MAX_ARRAY_TEXTURE_LAYERS", 2048);
+    g.max_draw_buffers = GetInt(*params, "MAX_DRAW_BUFFERS", 8);
+    g.max_uniform_buffer_bindings =
+        GetInt(*params, "MAX_UNIFORM_BUFFER_BINDINGS", 24);
+    g.max_combined_texture_image_units =
+        GetInt(*params, "MAX_COMBINED_TEXTURE_IMAGE_UNITS", 32);
+    g.max_color_attachments = GetInt(*params, "MAX_COLOR_ATTACHMENTS", 8);
+    g.uniform_buffer_offset_alignment =
+        GetInt(*params, "UNIFORM_BUFFER_OFFSET_ALIGNMENT", 256);
+    g.max_texture_lod_bias = GetInt(*params, "MAX_TEXTURE_LOD_BIAS", 2);
+  }
+
+  const base::ListValue* ext_list = d.FindList("extensions");
+  if (ext_list) {
+    for (const auto& e : *ext_list) {
+      if (e.is_string())
+        g.extensions.push_back(e.GetString());
+    }
+  }
+  return g;
+}
+
+LocaleData ParseLocale(const base::DictValue& d) {
+  LocaleData l;
+  l.timezone = GetString(d, "timezone", "America/New_York");
+  l.language = GetString(d, "language", "en-US");
+  const base::ListValue* langs = d.FindList("languages");
+  if (langs) {
+    l.languages.clear();
+    for (const auto& v : *langs) {
+      if (v.is_string())
+        l.languages.push_back(v.GetString());
+    }
+  }
+  return l;
+}
+
+CanvasData ParseCanvas(const base::DictValue& d) {
+  CanvasData c;
+  c.mode = GetString(d, "canvas_mode", "spoofed");
+  c.gamma = GetDouble(d, "gamma", 1.8);
+  c.contrast = GetDouble(d, "contrast", 0.5);
+  return c;
+}
+
+ConnectionData ParseConnection(const base::DictValue& d) {
+  ConnectionData c;
+  c.effective_type = GetString(d, "effectiveType", "4g");
+  c.downlink = GetDouble(d, "downlink", 10.0);
+  c.rtt = GetInt(d, "rtt", 50);
+  c.save_data = GetBool(d, "saveData", false);
+  return c;
+}
+
+TogglesData ParseToggles(const base::DictValue& d) {
+  TogglesData t;
+  t.screen = GetBool(d, "screen", true);
+  t.cpu_memory = GetBool(d, "cpu_memory", true);
+  t.gpu_webgl = GetBool(d, "gpu_webgl", true);
+  t.canvas = GetBool(d, "canvas", true);
+  t.audio = GetBool(d, "audio", true);
+  t.fonts = GetBool(d, "fonts", true);
+  t.locale_tz = GetBool(d, "locale_tz", true);
+  t.network = GetBool(d, "network", true);
+  t.voices = GetBool(d, "voices", true);
+  t.permissions = GetBool(d, "permissions", true);
+  t.window_size = GetBool(d, "window_size", true);
+  t.webrtc = GetBool(d, "webrtc", true);
+  return t;
+}
+
+}  // namespace
+
+std::optional<ProfileData> LoadProfileFromJson(const std::string& json_str) {
+  auto parsed = base::JSONReader::ReadDict(json_str, base::JSON_PARSE_RFC);
+  if (!parsed) {
+    LOG(ERROR) << "kr: Failed to parse profile JSON";
+    return std::nullopt;
+  }
+
+  const base::DictValue& root = *parsed;
+  ProfileData p;
+  p.schema = GetInt(root, "schema", 1);
+  p.seed = GetString(root, "seed");
+
+  if (p.seed.empty()) {
+    LOG(ERROR) << "kr: Profile missing seed";
+    return std::nullopt;
+  }
+
+  const base::DictValue* toggles = root.FindDict("toggles");
+  if (toggles)
+    p.toggles = ParseToggles(*toggles);
+
+  const base::DictValue* screen = root.FindDict("screen");
+  if (screen)
+    p.screen = ParseScreen(*screen);
+
+  const base::DictValue* nav = root.FindDict("navigator");
+  if (nav)
+    p.navigator = ParseNavigator(*nav);
+
+  const base::DictValue* gpu = root.FindDict("gpu");
+  if (gpu)
+    p.gpu = ParseGpu(*gpu);
+
+  const base::DictValue* locale = root.FindDict("locale");
+  if (locale)
+    p.locale = ParseLocale(*locale);
+
+  const base::DictValue* canvas = root.FindDict("canvas");
+  if (canvas)
+    p.canvas = ParseCanvas(*canvas);
+
+  const base::DictValue* conn = root.FindDict("connection");
+  if (conn)
+    p.connection = ParseConnection(*conn);
+
+  const base::ListValue* fonts = root.FindList("fonts");
+  if (fonts) {
+    for (const auto& v : *fonts) {
+      if (v.is_string())
+        p.fonts.push_back(v.GetString());
+    }
+  }
+
+  const base::ListValue* voices = root.FindList("voices");
+  if (voices) {
+    for (const auto& v : *voices) {
+      if (!v.is_dict())
+        continue;
+      const auto& vd = v.GetDict();
+      VoiceData voice;
+      voice.name = GetString(vd, "name");
+      voice.lang = GetString(vd, "lang");
+      voice.is_default = GetBool(vd, "default", false);
+      voice.local_service = GetBool(vd, "localService", true);
+      p.voices.push_back(std::move(voice));
+    }
+  }
+
+  return p;
+}
+
+std::optional<ProfileData> LoadProfileFromFile(const std::string& path) {
+  std::ifstream file(path);
+  if (!file.is_open()) {
+    LOG(ERROR) << "kr: Cannot open profile file: " << path;
+    return std::nullopt;
+  }
+  std::ostringstream ss;
+  ss << file.rdbuf();
+  return LoadProfileFromJson(ss.str());
+}
+
+}  // namespace kr
