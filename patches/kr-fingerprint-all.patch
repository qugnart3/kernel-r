diff --git a/third_party/blink/renderer/platform/kr_fingerprint/canvas_noise.cc b/third_party/blink/renderer/platform/kr_fingerprint/canvas_noise.cc
new file mode 100644
index 0000000000..82dc4b5f86
--- /dev/null
+++ b/third_party/blink/renderer/platform/kr_fingerprint/canvas_noise.cc
@@ -0,0 +1,41 @@
+#include "third_party/blink/renderer/platform/kr_fingerprint/canvas_noise.h"
+
+#include "components/kr_fingerprint/deterministic_noise.h"
+#include "third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.h"
+
+namespace blink {
+namespace kr {
+
+void ApplyCanvasNoise(uint8_t* pixels,
+                      size_t width,
+                      size_t height,
+                      size_t row_bytes) {
+  const auto& fp = FingerprintProfile::Get();
+  if (!fp.IsActive() || !fp.IsToggleEnabled("canvas"))
+    return;
+
+  ::kr::DeterministicNoise noise(fp.seed(), "canvas");
+
+  for (size_t y = 0; y < height; ++y) {
+    uint8_t* row = pixels + y * row_bytes;
+    for (size_t x = 0; x < width; ++x) {
+      // RGBA: 4 bytes per pixel. Only perturb RGB, leave alpha alone.
+      size_t offset = x * 4;
+      for (size_t c = 0; c < 3; ++c) {
+        uint8_t val = row[offset + c];
+        // Skip pure 0 and 255 to avoid creating visible noise on
+        // transparent or saturated regions.
+        if (val == 0 || val == 255)
+          continue;
+        int delta = noise.IntRange(-1, 1);
+        int result = static_cast<int>(val) + delta;
+        if (result < 1) result = 1;
+        if (result > 254) result = 254;
+        row[offset + c] = static_cast<uint8_t>(result);
+      }
+    }
+  }
+}
+
+}  // namespace kr
+}  // namespace blink
