diff --git a/third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.cc b/third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.cc
new file mode 100644
index 0000000000..2ce949f47c
--- /dev/null
+++ b/third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.cc
@@ -0,0 +1,54 @@
+#include "third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.h"
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+
+namespace blink {
+namespace kr {
+
+FingerprintProfile::FingerprintProfile(::kr::ProfileData data)
+    : data_(std::move(data)), active_(true) {}
+
+// static
+FingerprintProfile& FingerprintProfile::Get() {
+  static base::NoDestructor<FingerprintProfile> instance;
+  return *instance;
+}
+
+// static
+void FingerprintProfile::Initialize(::kr::ProfileData data) {
+  FingerprintProfile& fp = Get();
+  CHECK(!fp.active_) << "kr: FingerprintProfile already initialized";
+  fp.data_ = std::move(data);
+  fp.active_ = true;
+  LOG(INFO) << "kr: FingerprintProfile initialized, seed="
+            << fp.data_.seed.substr(0, 8) << "...";
+}
+
+// static
+bool FingerprintProfile::IsActive() {
+  return Get().active_;
+}
+
+bool FingerprintProfile::IsToggleEnabled(std::string_view group) const {
+  if (!active_)
+    return false;
+  const auto& t = data_.toggles;
+  if (group == "screen") return t.screen;
+  if (group == "cpu_memory") return t.cpu_memory;
+  if (group == "gpu_webgl") return t.gpu_webgl;
+  if (group == "canvas") return t.canvas;
+  if (group == "audio") return t.audio;
+  if (group == "fonts") return t.fonts;
+  if (group == "locale_tz") return t.locale_tz;
+  if (group == "network") return t.network;
+  if (group == "voices") return t.voices;
+  if (group == "permissions") return t.permissions;
+  if (group == "window_size") return t.window_size;
+  if (group == "webrtc") return t.webrtc;
+  return false;
+}
+
+}  // namespace kr
+}  // namespace blink
diff --git a/third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.h b/third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.h
new file mode 100644
index 0000000000..3457b53941
--- /dev/null
+++ b/third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.h
@@ -0,0 +1,48 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_KR_FINGERPRINT_FINGERPRINT_PROFILE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_KR_FINGERPRINT_FINGERPRINT_PROFILE_H_
+
+#include <memory>
+#include <string_view>
+
+#include "base/no_destructor.h"
+#include "components/kr_fingerprint/profile_data.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+namespace kr {
+
+class PLATFORM_EXPORT FingerprintProfile {
+ public:
+  static FingerprintProfile& Get();
+  static void Initialize(::kr::ProfileData data);
+  static bool IsActive();
+
+  const ::kr::ProfileData& data() const { return data_; }
+  const ::kr::ScreenData& screen() const { return data_.screen; }
+  const ::kr::NavigatorData& navigator() const { return data_.navigator; }
+  const ::kr::GpuData& gpu() const { return data_.gpu; }
+  const ::kr::LocaleData& locale() const { return data_.locale; }
+  const ::kr::CanvasData& canvas() const { return data_.canvas; }
+  const ::kr::ConnectionData& connection() const { return data_.connection; }
+  const std::vector<std::string>& fonts() const { return data_.fonts; }
+  const ::kr::TogglesData& toggles() const { return data_.toggles; }
+  const std::string& seed() const { return data_.seed; }
+
+  bool IsToggleEnabled(std::string_view group) const;
+
+  FingerprintProfile(const FingerprintProfile&) = delete;
+  FingerprintProfile& operator=(const FingerprintProfile&) = delete;
+
+ private:
+  friend class base::NoDestructor<FingerprintProfile>;
+  FingerprintProfile() = default;
+  explicit FingerprintProfile(::kr::ProfileData data);
+
+  ::kr::ProfileData data_;
+  bool active_ = false;
+};
+
+}  // namespace kr
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_KR_FINGERPRINT_FINGERPRINT_PROFILE_H_
