+
+struct GpuData {
+  std::string vendor;
+  std::string renderer;
+  int max_texture_size = 16384;
+  int max_cube_map_texture_size = 16384;
+  int max_texture_image_units = 16;
+  int max_vertex_attribs = 16;
+  int max_vertex_uniform_vectors = 4095;
+  int max_fragment_uniform_vectors = 1024;
+  int max_renderbuffer_size = 16384;
+  int max_varying_vectors = 30;
+  int max_vertex_texture_image_units = 16;
+  int max_samples = 8;
+  int max_3d_texture_size = 2048;
+  int max_array_texture_layers = 2048;
+  int max_draw_buffers = 8;
+  int max_uniform_buffer_bindings = 24;
+  int max_combined_texture_image_units = 32;
+  int max_color_attachments = 8;
+  int uniform_buffer_offset_alignment = 256;
+  int max_texture_lod_bias = 2;
+  std::array<int, 2> max_viewport_dims = {32767, 32767};
+  std::array<float, 2> aliased_line_width_range = {1.0f, 1.0f};
+  std::array<float, 2> aliased_point_size_range = {1.0f, 1024.0f};
+  std::vector<std::string> extensions;
+};
+
+struct LocaleData {
+  std::string timezone = "America/New_York";
+  std::string language = "en-US";
+  std::vector<std::string> languages = {"en-US", "en"};
+};
+
+struct CanvasData {
+  std::string mode = "spoofed";
+  double gamma = 1.8;
+  double contrast = 0.5;
+};
+
+struct ConnectionData {
+  std::string effective_type = "4g";
+  double downlink = 10.0;
+  int rtt = 50;
+  bool save_data = false;
+};
+
+struct VoiceData {
+  std::string name;
+  std::string lang;
+  bool is_default = false;
+  bool local_service = true;
+};
+
+struct TogglesData {
+  bool screen = true;
+  bool cpu_memory = true;
+  bool gpu_webgl = true;
+  bool canvas = true;
+  bool audio = true;
+  bool fonts = true;
+  bool locale_tz = true;
+  bool network = true;
+  bool voices = true;
+  bool permissions = true;
+  bool window_size = true;
+  bool webrtc = true;
+};
+
+struct ProfileData {
+  int schema = 1;
+  std::string seed;
+  TogglesData toggles;
+  ScreenData screen;
