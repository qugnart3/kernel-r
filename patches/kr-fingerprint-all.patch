diff --git a/components/kr_fingerprint/deterministic_noise.cc b/components/kr_fingerprint/deterministic_noise.cc
new file mode 100644
index 0000000000..0885f276e1
--- /dev/null
+++ b/components/kr_fingerprint/deterministic_noise.cc
@@ -0,0 +1,51 @@
+#include "components/kr_fingerprint/deterministic_noise.h"
+
+#include <cstring>
+
+#include "third_party/boringssl/src/include/openssl/sha.h"
+#include "third_party/boringssl/src/include/openssl/siphash.h"
+
+namespace kr {
+
+DeterministicNoise::DeterministicNoise(const std::string& seed,
+                                       const std::string& domain)
+    : seed_(seed), domain_(domain) {
+  std::string material = seed + "|" + domain;
+  uint8_t digest[SHA256_DIGEST_LENGTH];
+  SHA256(reinterpret_cast<const uint8_t*>(material.data()), material.size(),
+         digest);
+  memcpy(&key_[0], digest, 8);
+  memcpy(&key_[1], digest + 8, 8);
+}
+
+uint64_t DeterministicNoise::Hash(const uint8_t* data, size_t len) const {
+  return SIPHASH_24(key_, data, len);
+}
+
+uint64_t DeterministicNoise::Hash(const std::string& data) const {
+  return Hash(reinterpret_cast<const uint8_t*>(data.data()), data.size());
+}
+
+double DeterministicNoise::Uniform01() const {
+  uint64_t c = counter_++;
+  uint64_t h = Hash(reinterpret_cast<const uint8_t*>(&c), sizeof(c));
+  return static_cast<double>(h >> 11) / static_cast<double>(1ULL << 53);
+}
+
+double DeterministicNoise::UniformRange(double lo, double hi) const {
+  return lo + Uniform01() * (hi - lo);
+}
+
+int32_t DeterministicNoise::IntRange(int32_t lo, int32_t hi) const {
+  if (lo >= hi) return lo;
+  uint64_t c = counter_++;
+  uint64_t h = Hash(reinterpret_cast<const uint8_t*>(&c), sizeof(c));
+  return lo + static_cast<int32_t>(h % static_cast<uint64_t>(hi - lo));
+}
+
+DeterministicNoise DeterministicNoise::WithSubDomain(
+    const std::string& sub) const {
+  return DeterministicNoise(seed_, domain_ + "." + sub);
+}
+
+}  // namespace kr
diff --git a/components/kr_fingerprint/deterministic_noise.h b/components/kr_fingerprint/deterministic_noise.h
new file mode 100644
index 0000000000..21ca2ea1e1
--- /dev/null
+++ b/components/kr_fingerprint/deterministic_noise.h
@@ -0,0 +1,31 @@
+#ifndef COMPONENTS_KR_FINGERPRINT_DETERMINISTIC_NOISE_H_
+#define COMPONENTS_KR_FINGERPRINT_DETERMINISTIC_NOISE_H_
+
+#include <cstdint>
+#include <string>
+
+namespace kr {
+
+class DeterministicNoise {
+ public:
+  DeterministicNoise(const std::string& seed, const std::string& domain);
+
+  uint64_t Hash(const uint8_t* data, size_t len) const;
+  uint64_t Hash(const std::string& data) const;
+
+  double Uniform01() const;
+  double UniformRange(double lo, double hi) const;
+  int32_t IntRange(int32_t lo, int32_t hi) const;
+
+  DeterministicNoise WithSubDomain(const std::string& sub) const;
+
+ private:
+  uint64_t key_[2];
+  std::string seed_;
+  std::string domain_;
+  mutable uint64_t counter_ = 0;
+};
+
+}  // namespace kr
+
+#endif  // COMPONENTS_KR_FINGERPRINT_DETERMINISTIC_NOISE_H_
