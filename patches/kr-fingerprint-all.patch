+#include "third_party/blink/renderer/platform/kr_fingerprint/fingerprint_profile.h"
+
+namespace blink {
+namespace kr {
+
+void ApplyAudioNoise(float* samples, size_t count) {
+  const auto& fp = FingerprintProfile::Get();
+  if (!fp.IsActive() || !fp.IsToggleEnabled("audio"))
+    return;
+
+  ::kr::DeterministicNoise noise(fp.seed(), "audio");
+  for (size_t i = 0; i < count; ++i) {
+    float val = samples[i];
+    if (val == 0.0f)
+      continue;
+    double delta = noise.Uniform01() * 2e-7 - 1e-7;
+    samples[i] = static_cast<float>(static_cast<double>(val) + delta);
+  }
+}
+
+}  // namespace kr
+}  // namespace blink
